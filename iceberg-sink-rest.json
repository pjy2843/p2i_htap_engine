{
  "name": "iceberg-oorder",
  "config": {
    "connector.class": "io.tabular.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "1",
    "topics": "postgres-oorder",
    "iceberg.tables": "iceberg.oorder",
    "iceberg.catalog.type": "rest",
    "iceberg.catalog.uri": "http://0.0.0.0:8181",
    "iceberg.catalog.warehouse": "s3a://vldb-000/iceberg/oorder/",
    "iceberg.catalog.s3.access-key-id": "DUMMY_ACCESS_KEY_ID",
    "iceberg.catalog.s3.secret-access-key": "DUMMY_SECRET_KEY_VALUE",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "flush.interval.ms": "1000",
    "flush.size": "1",
    "iceberg.control.commit.interval-ms": "1000",
    "iceberg.control.commit.timeout-ms": "60000"
  }
}